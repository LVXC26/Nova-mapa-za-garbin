# Supabase — javna (brskalnik) povezava
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role ključ, SAMO za strežniške API poti (admin/uporabniki,
# webhook za promocije). Nikoli ne izpostavite tega ključa v brskalniku/NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — plačljiva promocija oglasov (/dashboard/moja-plovila)
# Secret key iz Stripe dashboarda (Developers → API keys)
STRIPE_SECRET_KEY=
# Webhook signing secret iz Stripe dashboarda (Developers → Webhooks → Add endpoint
# → https://vasadomena.si/api/webhooks/stripe → poslušaj na "checkout.session.completed")
STRIPE_WEBHOOK_SECRET=

# Google Analytics / Meta Pixel (neobvezno)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
